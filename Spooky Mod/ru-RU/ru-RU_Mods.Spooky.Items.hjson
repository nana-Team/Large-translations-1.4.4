}

BigBoneBow: {
	DisplayName: Flower Shot
	Tooltip:
		'''
		Converts wooden arrows into piercing roses than can slightly home in on enemies
		Right click to shoot a stationary thorn flower that inflicts thorn mark on enemies
		Enemies with the thorn mark debuff will take more damage from the piercing roses
