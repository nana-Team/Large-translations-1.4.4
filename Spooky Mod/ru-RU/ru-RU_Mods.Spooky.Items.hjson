Bonemeal: {
	DisplayName: Bonemeal
	Tooltip: All blooms nearby you will grow at a decently faster rate
}

DaylightSavings: {
	DisplayName: Daylight Savings
	Tooltip: Your bloom buffs have a 20% chance to continue for 2 extra minutes when they run out
}

FarmerGlove: {
	DisplayName: Садовые перчатки
	Tooltip: Увеличивает скорость атаки на 10% за каждое активное цветенье
}

HerbShaker: {
	DisplayName: Herbs and Spices
	Tooltip: When you eat a bloom you don't have, gain a random buff for one minute
}

TheMask: {
	DisplayName: Странная маска
	Tooltip: Увеличивает защиту на 5 ед. за каждое активное цветенье
}

Wormy: {
	DisplayName: Чарли червячок
	Tooltip:
		'''
		Призывает дружелюбного червяка сражаться за вас
		Каждое активное цветенье увеличивает его урон
		'''
}

CemeteryLily: {
	DisplayName: Lily of Rebirth
	Tooltip:
		'''
		Cuts your maximum health down to a third and gives you 2 revives
		Upon death you will loose a revive and gain stat buffs for 15 seconds
		3 minute duration
		'''
}

CemeteryMarigold: {
	DisplayName: Guiding Marigold
	Tooltip:
		'''
		Occasionally plant damaging marigolds while moving
		The damage of the marigolds increases the faster you are moving
		5 minute duration
		'''
}

CemeteryPoppy: {
	DisplayName: Ornamental Poppy
	Tooltip:
		'''
		When an enemy dies, spawn a poppy that shoots at other nearby enemies for a bit
		Only up to 3 poppies can exist at a time
		5 minute duration
		'''
}

CemeteryRose: {
	DisplayName: Withered Rose
	Tooltip:
		'''
		Causes you to take 10% more damage
		When you take damage, you will release powerful withered petals
		The withered petals damage becomes stronger the more damage you take
		3 minute duration
		'''
}

DandelionHerd: {
	DisplayName: Dandelion Herd
	Tooltip:
		'''
		Leave behind dandelion seed clusters while flying that can slightly home on enemies
		The seed clusters will deal more damage the higher your maximum flight time is
		2 minute duration
		'''
}

DandelionMapleSeed: {
	DisplayName: Whindwhirl Mapleseed
	Tooltip:
		'''
		Occasionally spawns a gliding mapleseed around you while you are flying
		Collecting these mapleseeds will slightly boost your flight time
		4 minute duration
		'''
}

DandelionTumbleweed: {
	DisplayName: Tumblingweed
	Tooltip:
		'''
		Hitting enemies while flying may spawn damaging tumbleweeds to attack
		5 minute duration
		'''
}

Dragonfruit: {
	DisplayName: Diva Dragon Fruit
	Tooltip:
		'''
		Spawns a dragon fruit that will orbit around you and chase nearby enemies
		After hitting an enemy the fruit will die, and will respawn after a few seconds
		Eating multiple of this bloom while having this bloom's effect will increase its stack
		Each stack of this buff gives you an additional orbiting fruit, up to 10 total
		3 minute duration
		'''
}

FallGourd: {
	DisplayName: The Squash
	Tooltip:
		'''
		Increases damage by 15% while you are falling down
		5 minute duration
		'''
}

FallSoulPumpkin: {
	DisplayName: Pumptergeist
	Tooltip:
		'''
		Occasionally spawn a homing ghastly pumpkin while holding a weapon
		The damage of the pumpkins scales based on the weapon you are holding
		The ghastly pumpkins will ignite enemies for a short time
		4 minute duration
		'''
}

FallWaterGourd: {
	DisplayName: Watering Gourd
	Tooltip:
		'''
		Fully grown bloom crops have a chance to yield an extra bloom and seed
		10 minute duration
		'''
}

FallZucchini: {
	DisplayName: Zappy Zucchini
	Tooltip:
		'''
		Occasionally zap nearby enemies with zucchini electricity for a few seconds
		Electricity damage scales based on the enemies damage
		2 minute duration
		'''
}

FossilBlackPepper: {
	DisplayName: Black Pepper Pebbles
	Tooltip:
		'''
		Sometimes shoot out pepper pebbles that increase defense when picked up
		If your defense is lower, you will spawn pepper pebbles more frequently
		Each one increases defense by 2, and will stack up to a maximum of 20
		This defense bonus will last until this bloom's effect runs out
		5 minute duration
		'''
}

FossilDutchmanPipe: {
	DisplayName: Dutchman's Pipe
	Tooltip:
		'''
		Creates a large dutchman pipe aura around you
		Hitting enemies in the aura with projectiles causes all enemies in the aura to take damage
		5 minute duration
		'''
}

FossilMagnolia: {
	DisplayName: Sturdy Magnolia
	Tooltip:
		'''
		Grants damage reduction when you are below maximum health
		The damage reduction increases the lower your health is
		3 minute duration
		'''
}

FossilProtea: {
	DisplayName: Diamond Protea
	Tooltip:
		'''
		Gives you a heavy protea shield that increases your defense 
		This shield also causes you to fall significantly faster
		Falling from high enough will launch damaging diamonds upward
		2 minute duration
		'''
}

FungusBluePinkgill: {
	DisplayName: Spectral Bluegill
	Tooltip:
		'''
		Hitting enemies may inflict them with spectral spores
		This debuff makes enemies spawn homing magic spores every second
		3 minute duration
		'''
}

FungusDevilTooth: {
	DisplayName: Bleeding Gums Fungus
	Tooltip:
		'''
		Hitting enemies may inflict them with fungal gingivitis
		This debuff makes enemies spawn bloody teeth globs when killed
		When touched, these globs will explode and fire off teeth
		3 minute duration
		'''
}

FungusInkCap: {
	DisplayName: Inky Toadstool
	Tooltip:
		'''
		Hitting enemies may inflict them with ink spores
		This debuff makes enemies spawn lingering ink spores when damaged
		3 minute duration
		'''
}

FungusRedCage: {
	DisplayName: Red Cage Fungus
	Tooltip:
		'''
		Hitting enemies may grow a cage fungus that slows them down while its active
		3 minute duration
		'''
}

SeaBarnacle: {
	DisplayName: Giant Barnacle
	Tooltip:
		'''
		Hitting enemies with projectiles will sometimes infest them with damaging barnacles
		Barnacles have a chance to create another barnacle when inflicting damage
		Barnacles will grow on enemies faster if it is raining
		3 minute duration
		'''
}

SeaCucumber: {
	DisplayName: Gluttonous Cucumber
	Tooltip:
		'''
		Shoot out a stomach at a nearby enemy that will attach to them
		The stomach will remain attached as long as you are close enough to that enemy
		While attached it damages the enemy over time and will periodically heal you
		If it is raining the damage over time and healing becomes stronger
		5 minute duration
		'''
}

SeaSponge: {
	DisplayName: Scrubby Sea Sponge
	Tooltip:
		'''
		Grants a small chance to absorb any hostile projectile that comes near you
		Absorbing a projectile will increase your damage reduction for 10 seconds
		The chance of absorbing a projectile increases if it is raining
		3 minute duration
		'''
}

SeaUrchin: {
	DisplayName: Ouchy Urchin
	Tooltip:
		'''
		Grow a spiny venomous sea urchin on your head
		The sea urchin will retaliate with venomous spikes when you take damage
		If it is raining the urchins venomous spikes become stronger
		4 minute duration
		'''
}

SpringHeartFlower: {
	DisplayName: Bleeding Heart
	Tooltip:
		'''
		Grants increased life regeneration for each of your occupied bloom buff slots
		5 minute duration
		'''
}

SpringIris: {
	DisplayName: Dilated Iris
	Tooltip:
		'''
		Every minute, you will spawn an iris petal and a large eye on your cursor
		The iris petal slowly chases the eye and speeds up over time while damaging anything it touches
		The petal and eye will both die when they collide with each other
		5 minute duration
		'''
}

SpringOrchid: {
	DisplayName: Monkey Orchid
	Tooltip:
		'''
		Weapons have a chance to shoot a spread of monkey orchid shurikens when used
		The shurikens damage scales based on the damage of the weapon used
		4 minute duration
		'''
}

SpringRose: {
	DisplayName: Thorn Tipped Rose
	Tooltip:
		'''
		Grants you a ring of thorns that deals a small amount of damage to enemies
		The thorn ring can also sometimes inflict bleeding for a short time
		6 minute duration
		'''
}

SummerLemon: {
	DisplayName: Multiplemon
	Tooltip:
		'''
		Using weapons will sometimes shoot bouncing lemon bombs
		Each lemon shot consecutively will cause an extra bouncy lemon to shoot out
		5 minute duration
		'''
}

SummerOrange: {
	DisplayName: Angry Orange
	Tooltip:
		'''
		Gain an orbiting angry orange that damages enemies and burns them
		The faster you are moving, the more its speed, range, and damage increases
		5 minute duration
		'''
}

SummerPineapple: {
	DisplayName: Poker Pineapple
	Tooltip:
		'''
		Increases damage dealt from critical hits by 35% but halves your overall critical strike chance
		Landing a critical hit will also heal a bit of your health
		5 minute duration
		'''
}

SummerSunflower: {
	DisplayName: Sunny Side Up
	Tooltip:
		'''
		Significantly increases the growth rate of all bloom crops
		Gives you the happy sunflower buff for 2 minutes
		5 minute duration
		'''
}

UltimateTomato: {
	DisplayName: Ultimato
	Tooltip:
		'''
		Press the Accessory Hotkey while holding a weapon to throw around a ton of tomatoes
		The damage of these tomatoes will scale based on the weapon you are holding
		Every use of this ability will subtract 20 seconds off of this bloom's duration
		5 minute duration
		'''
}

VegetableCauliflower: {
	DisplayName: Cauliflower Trio
	Tooltip:
		'''
		Grants a 10% increase to your summon damage
		Hitting enemies with whips can summon homing cauliflower
		5 minute duration
		'''
}

VegetableEggplantPaint: {
	DisplayName: Grafitti Eggplant
	Tooltip:
		'''
		Grants a 10% increase to your ranged damage
		Ranged projectiles will leave behind damaging paint splatter
		5 minute duration
		'''
}

VegetablePepper: {
	DisplayName: California Reaper
	Tooltip:
		'''
		Grants a 10% increase to your melee damage
		Hitting enemies with melee weapons will inflict them with the pepper's spice
		Enemies inflicted with this spice will spew out fire at other nearby enemies
		5 minute duration
		'''
}

VegetableRomanesco: {
	DisplayName: Poisonous Romanesco
	Tooltip:
		'''
		Grants a 10% increase to your magic damage
		Using magic weapons can sometimes spawn a lingering romanesco 
		Hitting it with a magic projectile will cause it to explode into homing poison leaves
		5 minute duration
		'''
}

WinterBlackberry: {
	DisplayName: Blackberry Glacier
	Tooltip:
		'''
		Any blooms you eat will last for double their normal duration
		2 minute duration
		'''
}

WinterBlueberry: {
	DisplayName: Very Blues
	Tooltip:
		'''
		Hitting enemies may inflict them with frozen blueberry juice which will slown them down
		Any enemy nearby the initially hit enemy will also be inflicted with it for a shorter time
		4 minute duration
		'''
}

WinterGooseberry: {
	DisplayName: Plump Gooseberry
	Tooltip:
		'''
		Every third instance of damage you deal has a 33% chance to launch a gooseberry upward
		Gooseberries increase life regeneration and movement acceleration by 15% for a short time when picked up 
		Gooseberries will be destroyed upon making contact with hostile enemies or projectiles
		5 minute duration
		'''
}

WinterStrawberry: {
	DisplayName: Mountain Strawberry
	Tooltip:
		'''
		Every 40 seconds you will spawn some mountain strawberries you can pick up
		They grant 10% increased damage, critical strike chance, and knockback for 10 seconds
		5 minute duration
		'''
}

DaffodilHairpin: {
	DisplayName: Заколка-цветочек
	Tooltip:
		'''
		Вокруг вас будут появляться вращающиеся лепестки, вплоть до 6 штук
		Лепестки атакуют ближайших врагов при получении вами урона
		Урон лепестков зависит от урона атаки, активизировавших их, но не может быть менее 40 ед.
		'''
}

FlowerPotShoe: {
	DisplayName: Big Bone's Left Shoe
	Tooltip:
		'''
		Increases your maximum movement speed and movement acceleration
		Fire off homing flowers while you are flying or running
		The rate flowers are fired and their damage scales with your current speed
		'It couldn't have just walked away'
		'''
}

FlyCharm: {
	DisplayName: Очарование мухов
	Tooltip:
		'''
		Вокруг вас будет постепенно собираться рой из мух, вплоть до 10 особей
		Каждая муха увеличивает вашу защиту на 1 ед.
		Все мухи умрут при получении вами урона и начнут появляться снова только через 30 секунд
		'''
}

HunterScarf: {
	DisplayName: Шарф Старого охотника
	Tooltip:
		'''
		Отмечает врагов поблизости
		Отмеченные враги получают от вас на 25% больше урона
		'''
}

MocoNose: {
	DisplayName: Snotty Schnoz
	Tooltip:
		'''
		Gives you a snot bar that will fill up as you pick up snot globs
		Snot globs will occasionally drop when you damage enemies
		Once the bar is full, using any weapon will fire out a giant spread of snot
		The damage and speed of the snot scales based on the weapon you use when shooting them
		'''
}

MocoNoseBooger: {
	DisplayName: Snot
	Tooltip: ""
}

OrroboroEmbryo: {
	DisplayName: Undying Embryo
	Tooltip:
		'''
		Upon death you will be revived and given high life regeneration and defense for a short time
		This revive ability has a 5 minute cooldown before it can activate again
		During the cooldown, you gain 8% increased damage and critical strike chance
		'''
}

PumpkinSpiceLatte: {
	DisplayName: Pumpkin Spice Latte
	Tooltip: Can be used infinitely
}

SpiritAmulet: {
	DisplayName: Призрачный амулет
	Tooltip:
		'''
		Может призывать дружелюбное приведение кладбища при попадании по врагу
