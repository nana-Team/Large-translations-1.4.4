PlantChunk: {
	DisplayName: Plant Chunk
	Tooltip: A piece of living plant matter
}

Slot3Unlocker: {
	DisplayName: Костяная лопатка
	Tooltip:
		'''
		Очищает заросли с третьего слота эффектов цветений
