OldRifle: {
	DisplayName: Old Hunter's Rifle
	Tooltip: Converts basic bullets into rusty bullets that split on impact
}

PandoraAmalgam: {
	DisplayName: Amalghoul
	Tooltip:
		'''
		Grants the effects of every pandora's box accessory
		Spawns blobs of ectoplasm when you restore mana that deal more damage the more you restore
		Press the Accessory hotkey to release sound that damages you and enemies
		You will spawn hands every few seconds that will home in on you and heal you when hit
		Occasionally fire out a cuff at a nearby enemy, enemies attatched to it will take 25% more damage
		'''
}

PandoraChalice: {
	DisplayName: Несвятой Грааль
	Tooltip:
		'''
		При восстановлении маны будут призываться сгустки эктоплазмы, вплоть до 6 штук
		Через некоторое время сгустки эктоплазмы разлетаются и самонаводятся на ближайших врагов
		Чем больше маны было восстановлено, тем больше сгустки нанесут урона
		«Вам не стоит садится за руль после этого»
		'''
}

PandoraCross: {
	DisplayName: Крест
	Tooltip:
		'''
		Нажмите клавишу «Навык аксессуара», чтобы выпустить очередь из звуковых волн
		Звуковые волны наносят урон и отбрасывают врагов на большое расстояние
		Эта способность перезаряжается 40 секунд
		«Душераздирающий бас»
		'''
}

PandoraCuffs: {
	DisplayName: Кандалы Самсона
	Tooltip:
		'''
		Каждые 15 секунд цепляют на 5 секунд на ближайшего врага кандалы, увеличивающие получаемый этим врагом урон на 25%
		Кандалы в первую очередь будут стараться зацепиться за боссов, нежели на обычных врагов
		«Страдания закаляют душу»
		'''
}

PandoraRosary: {
	DisplayName: Призрачный розарий
	Tooltip:
		'''
		Каждые 5 секунд вокруг вас будут появляются призрачные руки, вплоть до 5 штук
		Эти руки будут восстанавливающие ваше здоровье при получении вами урона
		Руки не смогут появляться ещё 12 секунд после получения удара
		«Жуткие воскресенья»
		'''
}

RustyRing: {
	DisplayName: Rusted Ring
	Tooltip:
		'''
		Increases your maximum life by 60
		Increases your life regeneration
		Grants you the spelunker effect while in the dungeon or catacombs
		'''
}

SkullAmulet: {
	DisplayName: Skull Amulet
	Tooltip:
		'''
		Allows you to absorb the souls of enemies you kill 
		Each absorbed soul grants 2% increased damage
		After 10 souls are absorbed you will enter a frenzy for 10 seconds
		This frenzy gives you a massive boost to your attack speed
		Absorbing souls while in this frenzy will let you maintain it for longer
		'''
}

ThornStaff: {
	DisplayName: Rod of Ensnaring
	Tooltip:
		'''
		Casts thorn clumps that will ensnare and poison non-boss enemies
		Enemies cannot be ensnared again for 15 seconds
		Bosses will be poisoned for longer
		'''
}

BoneBow: {
	DisplayName: Bone Bender
