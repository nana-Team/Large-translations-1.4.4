RotGourd: {
	DisplayName: Тухлая тыква

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/RottenSeed] в жутком лесу. Семя можно получить при разрушении заплесневевших тыкв в этом же биоме.
		DespawnMessage: Все игроки получили по тыкве от тыквы.
	}
}

SpookySpirit: {
	DisplayName: Призрак-пугало

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/EMFReader] рядом с проклятой статуей ночью на заболоченном кладбище.
		DespawnMessage: Все игроки до смерти напугались Призрака-пугала.
	}
}

Moco: {
	DisplayName: Moco

	BossChecklistIntegration: {
		SpawnInfo: Right click the nose shrine in the valley of eyes while you have a [i:Spooky/CottonSwab] in your inventory.
		DespawnMessage: And yet, the snot-nosed bug does not remain
	}
}

DaffodilEye: {
	DisplayName: Нарцисс

	BossChecklistIntegration: {
		SpawnInfo: Бросьте в неё [i:Spooky/Brick], чтобы разбудить.
		DespawnMessage: Everyone has met their floral demise by daffodil
	}
}

OldHunterBoss: {
	DisplayName: Старый охотник

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/OldHunterSoul] рядом с трупом Старого охотника.
		DespawnMessage: The old hunter has defeated all players
	}
}

OrroHead: {
	DisplayName: Orro

	BossChecklistIntegration: {
		EntryName: Orro & Boro
		SpawnInfo: Use the [i:Spooky/Concoction] to pour acid on the giant egg in the valley of eyes, after you have completed the Egg Incursion event.
		DespawnMessage: All players were made not one by Orro & Boro
	}
}

BigBone: {
	DisplayName: Big Bone

	BossChecklistIntegration: {
		SpawnInfo: Use [i:Spooky/Fertilizer] while standing nearby the giant flower pot in the catacombs.
		DespawnMessage: Everyone has met their blooming doom by big bone
	}
}

SpookFishron: {
	DisplayName: Spook Fishron

	BossChecklistIntegration: {
		SpawnInfo: Fish in the ocean at night during a pumpkin moon while using a [i:Spooky/SinisterSnailItem] as bait. Sinister snails spawn in the underground spooky forest in hardmode.
		DespawnMessage: Every player has been turned into bad sushi
	}
}

